{
	"name": "amadeus",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "rimraf dist && tsc --outDir dist",
		"build:prod": "rimraf dist && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --minify --packages=external",
		"start": "node dist/index.js",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.3",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"@types/node": "^22.0.0",
		"esbuild": "^0.27.3",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.37",
		"@hono/node-server": "^1.13.0",
		"@nickyzj2023/utils": "^1.0.57",
		"ai": "^6.0.111",
		"hono": "^4.6.0",
		"sharp": "^0.34.5",
		"valibot": "^1.2.0",
		"zod": "^4.3.6"
	}
}
