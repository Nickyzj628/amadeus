{
	"name": "amadeus",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsdown && copyfiles -u 1 src/prompts/*.md dist-prod/",
		"build:prod": "tsdown --out-dir dist-prod && copyfiles -u 1 src/prompts/*.md dist-prod/",
		"start": "node dist/index.mjs",
		"start:prod": "node dist-prod/index.mjs",
		"check": "biome check --diagnostic-level=error --write src/"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.14",
		"@nickyzj2023/utils": "^1.0.64",
		"hono": "^4.12.14",
		"sharp": "^0.34.5",
		"undici": "^8.1.0",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@types/node": "^25.6.0",
		"copyfiles": "^2.4.1",
		"tsdown": "^0.21.9",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	}
}
