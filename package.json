{
	"name": "amadeus",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsdown && copyfiles -u 1 src/prompts/*.md dist-test/",
		"build:prod": "tsdown --out-dir dist && copyfiles -u 1 src/prompts/*.md dist/",
		"start": "node dist-test/index.mjs",
		"start:prod": "node dist/index.mjs",
		"check": "biome check --diagnostic-level=error --write src/"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.1",
		"@nickyzj2023/utils": "^1.0.69",
		"hono": "^4.12.17",
		"sharp": "^0.34.5",
		"undici": "^8.2.0",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@types/node": "^25.6.0",
		"copyfiles": "^2.4.1",
		"tsdown": "^0.21.10",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	}
}
